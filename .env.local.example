# ============================================
# Echo LLM Provider — pick ONE (or none for pre-scripted fallback)
# ============================================

# Option 1: Ollama (LOCAL, FREE — recommended for demo)
# Install: https://ollama.com → then run: ollama pull llama3.2
# USE_OLLAMA=true
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Option 2: Groq (CLOUD, FREE tier — 30 req/min)
# Sign up: https://console.groq.com → create API key
# GROQ_API_KEY=gsk_xxx

# Option 3: Anthropic (CLOUD, PAID — best quality)
# Sign up: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxx
